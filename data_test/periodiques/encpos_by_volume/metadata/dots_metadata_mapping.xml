<?xml version="1.0" encoding="UTF-8"?>
<dots:metadataMap xmlns:dots="https://github.com/chartes/dots/"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:html="http://www.w3.org/1999/xhtml">
  <dots:mapping>
    <!-- collections -->
    <dc:title scope="collection" format="csv" source="./default_resources_titles.tsv" value="title"/>
    <description scope="collection" format="csv" source="./default_resources_titles.tsv" value="description"/>
    <dct:license scope="collection" resourceId="all" value=".">https://creativecommons.org/licenses/by/4.0/</dct:license>
    <!-- documents -->
    <dc:title  scope="document" format="csv" source="./default_resources_titles.tsv" value="title"/>
    <html:h1 scope="document" format="csv" source="/./fragments_metadata.tsv" value="title_rich"/>
    <dct:license scope="document" resourceId="all" value=".">https://creativecommons.org/licenses/by-nc-sa/4.0/</dct:license>
    <dots:iiifManifestId scope="document" xpath="if (//sourceDesc/@facs) then let $id := lower-case(/TEI/@xml:id) return concat('https://iiif.chartes.psl.eu/encpos/', $id, '/manifest') else ()"/>
    <download scope="document" xpath="let $id := /TEI/@xml:id return concat('https://dev.chartes.psl.eu/dots/api/dts/document?resource=', $id)" key="XML"/>
    <download scope="document" xpath="//sourceDesc/@facs" key="PDF"/>
    <!-- fragments -->
    <dc:date  scope="fragment" format="csv" source="./fragments_metadata.tsv" value="promotion_year" type="number"/>
    <dc:creator scope="fragment" format="csv" source="./fragments_metadata.tsv" value="author_fullname_label"></dc:creator>
    <dct:creator scope="fragment" format="csv" source="./fragments_metadata.tsv" value="author_idref_ppn" prefix="https://www.idref.fr/" key="@id"/>
    <dct:creator scope="fragment" format="csv" source="./fragments_metadata.tsv" value="author_bnf_ark" prefix="https://data.bnf.fr/" key="@id"/>
    <dct:creator scope="fragment" format="csv" source="./fragments_metadata.tsv" value="author_wikidata_id" prefix="https://wikidata.org/entity/" key="@id"/>
    <dct:creator scope="fragment" format="csv" source="./fragments_metadata.tsv" value="author_wikipedia_url" key="@id"/>
    <dct:creator scope="fragment" format="csv" source="./fragments_metadata.tsv" value="author_dbpedia_id" prefix="https://dbpedia.org/resource/" key="@id"/>
    <dct:isVersionOf scope="fragment" format="csv" source="./fragments_metadata.tsv" value="thenca_these-record_id" prefix="http://bibnum.chartes.psl.eu/s/thenca/item/" key="@id"/>
    <dct:isVersionOf scope="fragment" format="csv" source="./fragments_metadata.tsv" value="benc_these-record_id" prefix="https://catalogue.chartes.psl.eu/cgi-bin/koha/opac-detail.pl?biblionumber=" key="@id"/>
    <dct:isVersionOf scope="fragment" format="csv" source="./fragments_metadata.tsv" value="sudoc_these-record_ppn" prefix="https://www.sudoc.fr/" key="@id"/>
    <dct:extent scope="fragment" format="csv" source="./fragments_metadata.tsv" value="pagination"/>
  </dots:mapping>
</dots:metadataMap>